":"DOI","asserted-by":"publisher"}]},{"DOI":"10.13039/100000001","name":"National Science Foundation","doi-asserted-by":"publisher","award":["2153746"],"award-info":[{"award-number":["2153746"]}],"id":[{"id":"10.13039/100000001","id-type":"DOI","asserted-by":"publisher"}]}],"content-domain":{"domain":[],"crossmark-restriction":false},"short-container-title":["Proc. Amer. Math. Soc."],"abstract":"<p>We give a self-contained proof of the strongest version of Mason’s conjecture, namely that for any matroid the sequence of the number of independent sets of given sizes is ultra log-concave. To do this, we introduce a class of polynomials, called completely log-concave polynomials, whose bivariate restrictions have ultra log-concave coefficients. At the heart of our proof we show that for any matroid, the homogenization of the generating polynomial of its independent sets is completely log-concave.</p>","DOI":"10.1090/proc/16724","type":"journal-article","created":{"date-parts":[[2024,3,20]],"date-time":"2024-03-20T16:59:28Z","timestamp":1710953968000},"source":"Crossref","is-referenced-by-count":5,"title":["Log-concave polynomials III: Mason’s ultra-log-concavity conjecture for independent sets of matroids"],"prefix":"10.1090","author":[{"given":"Nima","family":"Anari","sequence":"first","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Kuikui","family":"Liu","sequence":"additional","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Shayan","family":"Oveis Gharan","sequence":"additional","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Cynthia","family":"Vinzant","sequence":"additional","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]}],"member":"14","published-online":{"date-parts":[[2024,3,20]]},"reference":[{"issue":"2","key":"1","doi-asserted-by":"publisher","first-page":"381","DOI":"10.4007/annals.2018.188.2.1","article-title":"Hodge theory for combinatorial geo